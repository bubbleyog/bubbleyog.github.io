---
import { getCategoryById } from '../data/articles.js';

export interface Props {
  article: {
    id: string;
    title: string;
    category: string;
    date: string;
    description: string;
    tags: string[];
  };
}

const { article } = Astro.props;
const category = getCategoryById(article.category);

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<article class="article-card">
  <a href={`/article/${article.id}`} class="article-link">
    <div class="article-header">
      <span class="category-tag" style={`background: ${category.color}20; color: ${category.color}`}>
        {category.icon} {category.name}
      </span>
      <time class="article-date">{formatDate(article.date)}</time>
    </div>
    
    <h2 class="article-title">{article.title}</h2>
    <p class="article-description">{article.description}</p>
    
    <div class="article-footer">
      <div class="article-tags">
        {article.tags.slice(0, 3).map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
      <span class="read-more">
        阅读更多
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .article-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition: all 0.3s ease;
    overflow: hidden;
  }
  
  .article-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
  }
  
  .article-link {
    display: block;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  
  .article-link:hover {
    color: inherit;
  }
  
  .article-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .category-tag {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
  }
  
  .article-date {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  
  .article-title {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
    transition: color 0.3s ease;
  }
  
  .article-card:hover .article-title {
    color: var(--accent-primary);
  }
  
  .article-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  
  .read-more {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent-primary);
    transition: gap 0.3s ease;
  }
  
  .article-card:hover .read-more {
    gap: 0.5rem;
  }
  
  @media (max-width: 480px) {
    .article-link {
      padding: 1.25rem;
    }
    
    .article-title {
      font-size: 1.15rem;
    }
    
    .article-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
