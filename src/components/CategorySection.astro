---
import { getAllCategories, getCategoryName, getCategoryDescription } from '../data/articles.js';
import { t, type Locale } from '../i18n';
import { getLangFromUrl } from '../utils/locale';

const categories = getAllCategories();
const lang: Locale = getLangFromUrl(Astro.url);
const prefix = lang === 'en' ? '/en' : '';

// 从 Markdown 文件读取文章统计（import.meta.glob 空结果不抛错；按语言过滤）
const enModules = import.meta.glob('../content/articles/*.en.md');
const allModules = import.meta.glob('../content/articles/*.md');

const selectedModules =
  lang === 'en'
    ? enModules
    : Object.fromEntries(
        Object.entries(allModules).filter(([f]) => !f.endsWith('.en.md')),
      );

const entryList = await Promise.all(
  Object.entries(selectedModules).map(async ([, loader]) => {
    return await loader();
  }),
);

// 计算每个分类的文章数量
const categoryCount = {};
entryList.forEach((entry) => {
  const category = entry.frontmatter?.category || 'misc';
  categoryCount[category] = (categoryCount[category] || 0) + 1;
});
---

<section class="categories-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        {t(lang, 'categories.titlePrefix')} <span class="gradient-text">{t(lang, 'categories.titleKeyword')}</span>
      </h2>
      <p class="section-description">
        {t(lang, 'categories.description')}
      </p>
    </div>
    
    <div class="categories-grid">
      {categories.map(category => {
        const articleCount = categoryCount[category.id] || 0;
        return (
          <a href={`${prefix}/category/${category.id}`} class="category-card" style={`--category-color: ${category.color}`}>
            <div class="category-icon-wrapper">
              <span class="category-emoji">{category.icon}</span>
            </div>
            <div class="category-info">
              <h3 class="category-title">{getCategoryName(category, lang)}</h3>
              <p class="category-desc">{getCategoryDescription(category, lang)}</p>
              <span class="article-count">{articleCount} {lang === 'en' ? (articleCount === 1 ? 'article' : 'articles') : '篇文章'}</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .categories-section {
    padding: 4rem 0;
    background: var(--bg-secondary);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .section-title {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }
  
  .section-description {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }
  
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  
  .category-card {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition: all 0.3s ease;
  }
  
  .category-card:hover {
    border-color: var(--category-color);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--category-color) 30%, transparent);
  }
  
  .category-card:hover .category-emoji {
    transform: scale(1.1) rotate(5deg);
  }
  
  .category-icon-wrapper {
    flex-shrink: 0;
  }
  
  .category-emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    font-size: 2rem;
    background: color-mix(in srgb, var(--category-color) 15%, transparent);
    border-radius: var(--radius-md);
    transition: transform 0.3s ease;
  }
  
  .category-info {
    flex: 1;
  }
  
  .category-title {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
    color: var(--text-primary);
  }
  
  .category-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }
  
  .article-count {
    font-size: 0.85rem;
    color: var(--category-color);
    font-weight: 500;
  }
  
  @media (max-width: 768px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
    
    .section-title {
      font-size: 1.75rem;
    }
  }
</style>
