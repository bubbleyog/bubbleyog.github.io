---
import ArticleCard from './ArticleCard.astro';
import { t, type Locale } from '../i18n';
import { getLangFromUrl } from '../utils/locale';

export interface Props {
  limit?: number;
  showHeader?: boolean;
}

const { limit = 6, showHeader = true } = Astro.props;
const lang: Locale = getLangFromUrl(Astro.url);
const prefix = lang === 'en' ? '/en' : '';

// 直接从 Markdown 文件读取文章（import.meta.glob 空结果不抛错；按语言过滤）
const enModules = import.meta.glob('../content/articles/*.en.md');
const allModules = import.meta.glob('../content/articles/*.md');

const selectedModules =
  lang === 'en'
    ? enModules
    : Object.fromEntries(
        Object.entries(allModules).filter(([f]) => !f.endsWith('.en.md')),
      );

const articles = (
  await Promise.all(
    Object.entries(selectedModules).map(async ([file, loader]) => {
      const entry = await loader();
      const pathParts = file.split('/') || [];
      const filename = pathParts[pathParts.length - 1] || '';
      const id = filename.replace(/\.en\.md$|\.md$/, '');
      const frontmatter = entry.frontmatter || {};
      return {
        id,
        title: frontmatter.title || (lang === 'en' ? 'Untitled' : '无标题'),
        category: frontmatter.category || 'misc',
        date: frontmatter.date || new Date().toISOString().split('T')[0],
        description: frontmatter.description || '',
        tags: frontmatter.tags || [],
      };
    }),
  )
)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, limit);
---

<section class="articles-section">
  <div class="container">
    {showHeader && (
      <div class="section-header">
        <h2 class="section-title">
          {t(lang, 'articles.titlePrefix')} <span class="gradient-text">{t(lang, 'articles.titleKeyword')}</span>
        </h2>
        <p class="section-description">
          {t(lang, 'articles.description')}
        </p>
      </div>
    )}
    
    <div class="articles-grid">
      {articles.map(article => (
        <ArticleCard article={article} />
      ))}
    </div>
    
    {showHeader && (
      <div class="view-all">
        <a href={`${prefix}/articles`} class="btn btn-secondary">
          <span>{t(lang, 'common.viewAll')}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .articles-section {
    padding: 4rem 0;
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .section-title {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }
  
  .section-description {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }
  
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }
  
  .view-all {
    text-align: center;
    margin-top: 3rem;
  }
  
  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
    
    .section-title {
      font-size: 1.75rem;
    }
  }
</style>
