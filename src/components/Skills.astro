---
const skillCategories = [
  {
    title: '前端开发',
    skills: [
      { name: 'HTML/CSS', level: 95 },
      { name: 'JavaScript', level: 90 },
      { name: 'React/Vue', level: 85 },
      { name: 'TypeScript', level: 80 },
    ],
  },
  {
    title: '后端开发',
    skills: [
      { name: 'Node.js', level: 85 },
      { name: 'Python', level: 75 },
      { name: 'PostgreSQL', level: 70 },
      { name: 'GraphQL', level: 65 },
    ],
  },
  {
    title: '设计与工具',
    skills: [
      { name: 'Figma', level: 80 },
      { name: 'Git', level: 85 },
      { name: 'Docker', level: 70 },
      { name: 'AWS', level: 60 },
    ],
  },
];

const tools = [
  'VS Code', 'GitHub', 'Figma', 'Vercel', 'Notion', 'Slack'
];
---

<section id="skills" class="skills">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">技能专长</span>
      <h2 class="section-title">
        我的 <span class="gradient-text">技术栈</span>
      </h2>
      <p class="section-description">
        我不断学习和探索新技术，以下是我在各个领域的技术能力和熟练程度。
      </p>
    </div>
    
    <div class="skills-grid">
      {skillCategories.map((category, categoryIndex) => (
        <div class="skill-category">
          <h3 class="category-title">{category.title}</h3>
          <div class="skill-list">
            {category.skills.map((skill, skillIndex) => (
              <div class="skill-item">
                <div class="skill-header">
                  <span class="skill-name">{skill.name}</span>
                  <span class="skill-level">{skill.level}%</span>
                </div>
                <div class="skill-bar">
                  <div 
                    class="skill-progress" 
                    style={`width: ${skill.level}%; animation-delay: ${categoryIndex * 0.2 + skillIndex * 0.1}s`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    
    <div class="tools-section">
      <h3 class="tools-title">常用工具</h3>
      <div class="tools-grid">
        {tools.map(tool => (
          <div class="tool-item">
            <span class="tool-dot"></span>
            <span class="tool-name">{tool}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    background: var(--bg-secondary);
  }
  
  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }
  
  .section-tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    color: var(--accent-primary);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  
  .section-title {
    margin-bottom: 1rem;
  }
  
  .section-description {
    font-size: 1.1rem;
  }
  
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }
  
  .skill-category {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }
  
  .category-title {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }
  
  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  
  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  
  .skill-name {
    font-weight: 500;
    color: var(--text-primary);
  }
  
  .skill-level {
    font-size: 0.875rem;
    color: var(--accent-primary);
    font-weight: 600;
  }
  
  .skill-bar {
    height: 8px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  
  .skill-progress {
    height: 100%;
    background: var(--accent-gradient);
    border-radius: var(--radius-full);
    animation: fillBar 1s ease-out forwards;
    width: 0;
  }
  
  @keyframes fillBar {
    to {
      width: var(--width, inherit);
    }
  }
  
  .tools-section {
    text-align: center;
  }
  
  .tools-title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }
  
  .tools-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  
  .tool-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    transition: all 0.3s ease;
  }
  
  .tool-item:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }
  
  .tool-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-primary);
    border-radius: 50%;
  }
  
  .tool-name {
    font-weight: 500;
    color: var(--text-secondary);
  }
  
  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
    
    .tools-grid {
      gap: 0.75rem;
    }
    
    .tool-item {
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
    }
  }
</style>
