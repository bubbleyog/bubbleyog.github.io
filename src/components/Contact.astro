---
const contactInfo = [
  {
    icon: '📧',
    label: '邮箱',
    value: 'hello@example.com',
    href: 'mailto:hello@example.com',
  },
  {
    icon: '📱',
    label: '电话',
    value: '+86 123 4567 8900',
    href: 'tel:+8612345678900',
  },
  {
    icon: '📍',
    label: '地址',
    value: '中国 · 城市',
    href: '#',
  },
];
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <span class="section-tag">联系我</span>
        <h2 class="section-title">
          让我们开始<br />
          <span class="gradient-text">合作吧</span>
        </h2>
        <p class="contact-description">
          有项目想法或者想聊聊技术？随时联系我，我很乐意听取你的想法并提供帮助。
        </p>
        
        <div class="contact-list">
          {contactInfo.map(item => (
            <a href={item.href} class="contact-item">
              <span class="contact-icon">{item.icon}</span>
              <div class="contact-details">
                <span class="contact-label">{item.label}</span>
                <span class="contact-value">{item.value}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
      
      <div class="contact-form-wrapper">
        <form class="contact-form" onsubmit="event.preventDefault(); alert('表单提交功能需要后端支持，请使用邮箱直接联系。');">
          <div class="form-group">
            <label for="name">姓名</label>
            <input type="text" id="name" name="name" placeholder="你的姓名" required />
          </div>
          
          <div class="form-group">
            <label for="email">邮箱</label>
            <input type="email" id="email" name="email" placeholder="your@email.com" required />
          </div>
          
          <div class="form-group">
            <label for="subject">主题</label>
            <input type="text" id="subject" name="subject" placeholder="项目咨询" required />
          </div>
          
          <div class="form-group">
            <label for="message">留言</label>
            <textarea id="message" name="message" rows="4" placeholder="告诉我你的想法..." required></textarea>
          </div>
          
          <button type="submit" class="btn btn-primary btn-full">
            <span>发送消息</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
  }
  
  .contact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-color), transparent);
  }
  
  .section-tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    color: var(--accent-primary);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  
  .section-title {
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  
  .contact-description {
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }
  
  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: all 0.3s ease;
  }
  
  .contact-item:hover {
    border-color: var(--accent-primary);
    transform: translateX(8px);
  }
  
  .contact-icon {
    font-size: 1.5rem;
  }
  
  .contact-details {
    display: flex;
    flex-direction: column;
  }
  
  .contact-label {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  
  .contact-value {
    font-weight: 500;
    color: var(--text-primary);
  }
  
  .contact-form-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }
  
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .form-group label {
    font-weight: 500;
    color: var(--text-primary);
    font-size: 0.95rem;
  }
  
  .form-group input,
  .form-group textarea {
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 1rem;
    font-family: inherit;
    transition: all 0.3s ease;
  }
  
  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-muted);
  }
  
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }
  
  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }
  
  .btn-full {
    width: 100%;
  }
  
  @media (max-width: 968px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    
    .contact-form-wrapper {
      order: -1;
    }
  }
  
  @media (max-width: 480px) {
    .contact-form-wrapper {
      padding: 1.5rem;
    }
  }
</style>
