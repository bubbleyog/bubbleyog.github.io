---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Footer from '../components/Footer.astro';

// 直接从 Markdown 文件读取所有文章
const markdownFiles = await Astro.glob('../content/articles/*.md');

const articles = markdownFiles
  .map((file) => {
    const pathParts = file.file?.split('/') || [];
    const filename = pathParts[pathParts.length - 1] || '';
    const id = filename.replace('.md', '');
    
    return {
      id,
      title: file.frontmatter?.title || '无标题',
      category: file.frontmatter?.category || 'misc',
      date: file.frontmatter?.date || new Date().toISOString().split('T')[0],
      description: file.frontmatter?.description || '',
      tags: file.frontmatter?.tags || [],
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout 
  title="全部文章 - Blog"
  description="浏览所有文章"
>
  <Header />
  
  <main class="articles-page">
    <!-- 页面头部 -->
    <section class="page-header">
      <div class="container">
        <div class="page-hero">
          <h1 class="page-title">全部 <span class="gradient-text">文章</span></h1>
          <p class="page-description">探索技术见解、学习心得和思考感悟</p>
          <span class="article-count">{articles.length} 篇文章</span>
        </div>
      </div>
    </section>
    
    <!-- 文章列表 -->
    <section class="articles-section">
      <div class="container">
        {articles.length > 0 ? (
          <div class="articles-grid">
            {articles.map(article => (
              <ArticleCard article={article} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>暂无文章，敬请期待...</p>
          </div>
        )}
        
        <div class="back-link">
          <a href="/" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>返回首页</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .articles-page {
    padding-top: 70px;
  }
  
  .page-header {
    padding: 4rem 0;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, color-mix(in srgb, var(--accent-primary) 10%, var(--bg-secondary)) 100%);
    border-bottom: 1px solid var(--border-color);
  }
  
  .page-hero {
    text-align: center;
  }
  
  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }
  
  .page-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 1rem;
  }
  
  .article-count {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--bg-card);
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    color: var(--accent-primary);
    font-weight: 500;
  }
  
  .articles-section {
    padding: 3rem 0;
  }
  
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }
  
  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
  }
  
  .back-link {
    text-align: center;
    margin-top: 3rem;
  }
  
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
    
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
