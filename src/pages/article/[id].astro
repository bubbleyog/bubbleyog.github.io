---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllArticles, getArticleById, getCategoryById } from '../../data/articles.js';

// 生成所有文章的静态路径
export function getStaticPaths() {
  const articles = getAllArticles();
  return articles.map(article => ({
    params: { id: article.id },
  }));
}

const { id } = Astro.params;
const article = getArticleById(id);
const category = getCategoryById(article.category);

// 格式化日期
function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// 读取文章内容
const articles = await Astro.glob('/src/content/articles/*.md');
const currentArticle = articles.find(a => a.file.includes(id));

// 如果找不到文章，返回404
if (!currentArticle) {
  return Astro.redirect('/404');
}

const { Content } = currentArticle;
---

<Layout 
  title={`${article.title} - Blog`}
  description={article.description}
>
  <Header />
  
  <main class="article-page">
    <div class="container">
      <!-- 文章头部 -->
      <header class="article-header" style={`--category-color: ${category.color}`}>
        <div class="article-meta">
          <a href={`/category/${category.id}`} class="category-link">
            <span class="category-icon">{category.icon}</span>
            <span>{category.name}</span>
          </a>
          <time class="article-date">{formatDate(article.date)}</time>
        </div>
        
        <h1 class="article-title">{article.title}</h1>
        <p class="article-description">{article.description}</p>
        
        <div class="article-tags">
          {article.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>
      
      <!-- 文章内容 -->
      <article class="article-content">
        {Content ? <Content /> : <p>文章内容加载失败</p>}
      </article>
      
      <!-- 文章底部 -->
      <footer class="article-footer">
        <div class="article-nav">
          <a href="/" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>返回首页</span>
          </a>
          <a href={`/category/${category.id}`} class="btn btn-primary">
            <span>更多{category.name}文章</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </footer>
    </div>
  </main>
  
  <Footer />
</Layout>

<style define:vars={{ categoryColor: category.color }}>
  .article-page {
    padding-top: 100px;
    padding-bottom: 4rem;
  }
  
  .article-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }
  
  .article-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  
  .category-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: color-mix(in srgb, var(--category-color) 15%, transparent);
    border-radius: var(--radius-full);
    color: var(--category-color);
    font-weight: 500;
    transition: all 0.3s ease;
  }
  
  .category-link:hover {
    background: color-mix(in srgb, var(--category-color) 25%, transparent);
    color: var(--category-color);
  }
  
  .category-icon {
    font-size: 1.1rem;
  }
  
  .article-date {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  
  .article-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  
  .article-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }
  
  .article-tags {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .tag {
    padding: 0.4rem 1rem;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  
  /* 文章内容样式 */
  .article-content {
    max-width: 800px;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.8;
  }
  
  .article-content :global(h1) {
    font-size: 2rem;
    margin: 2rem 0 1rem;
    color: var(--text-primary);
  }
  
  .article-content :global(h2) {
    font-size: 1.6rem;
    margin: 2rem 0 1rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }
  
  .article-content :global(h3) {
    font-size: 1.3rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--text-primary);
  }
  
  .article-content :global(p) {
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
  }
  
  .article-content :global(ul), 
  .article-content :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
    color: var(--text-secondary);
  }
  
  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }
  
  .article-content :global(code) {
    background: var(--bg-tertiary);
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-sm);
    font-family: 'Fira Code', monospace;
    font-size: 0.9em;
    color: var(--accent-primary);
  }
  
  .article-content :global(pre) {
    background: var(--bg-tertiary);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border-color);
  }
  
  .article-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text-secondary);
  }
  
  .article-content :global(blockquote) {
    border-left: 4px solid var(--category-color);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
    font-style: italic;
  }
  
  .article-content :global(a) {
    color: var(--category-color);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  
  .article-content :global(a:hover) {
    color: var(--text-primary);
  }
  
  .article-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  
  /* 文章底部 */
  .article-footer {
    max-width: 800px;
    margin: 4rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }
  
  .article-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  @media (max-width: 768px) {
    .article-title {
      font-size: 1.75rem;
    }
    
    .article-description {
      font-size: 1rem;
    }
    
    .article-content {
      font-size: 1rem;
    }
    
    .article-content :global(h1) {
      font-size: 1.6rem;
    }
    
    .article-content :global(h2) {
      font-size: 1.35rem;
    }
    
    .article-nav {
      flex-direction: column;
    }
    
    .article-nav .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
