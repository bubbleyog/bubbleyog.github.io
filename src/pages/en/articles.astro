---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n';

// 直接从 Markdown 文件读取所有英文文章（import.meta.glob 空结果不抛错）
const modules = import.meta.glob('../../content/articles/*.en.md');

const rawEntries = await Promise.all(
  Object.entries(modules).map(async ([file, loader]) => {
    const entry = await loader();
    const pathParts = file.split('/') || [];
    const filename = pathParts[pathParts.length - 1] || '';
    const id = filename.replace(/\.en\.md$/, '');
    const frontmatter = entry.frontmatter || {};
    return {
      id,
      title: frontmatter.title || 'Untitled',
      category: frontmatter.category || 'misc',
      date: frontmatter.date || new Date().toISOString().split('T')[0],
      description: frontmatter.description || '',
      tags: frontmatter.tags || [],
    };
  }),
);

const articles = rawEntries.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
---

<Layout 
  title="All Articles - BubbleYog"
  description="Browse all articles"
  lang="en"
>
  <Header />
  
  <main class="articles-page">
    <!-- 页面头部 -->
    <section class="page-header">
      <div class="container">
        <div class="page-hero">
          <h1 class="page-title">{t('en', 'articles.pageTitlePrefix')} <span class="gradient-text">{t('en', 'articles.titleKeyword')}</span></h1>
          <p class="page-description">{t('en', 'articles.pageDescription')}</p>
          <span class="article-count">{articles.length} {articles.length === 1 ? 'article' : 'articles'}</span>
        </div>
      </div>
    </section>
    
    <!-- 文章列表 -->
    <section class="articles-section">
      <div class="container">
        {articles.length > 0 ? (
          <div class="articles-grid">
            {articles.map(article => (
              <ArticleCard article={article} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>{t('en', 'common.noArticlesGeneral')}</p>
          </div>
        )}
        
        <div class="back-link">
          <a href="/en" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>{t('en', 'common.backHome')}</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .articles-page {
    padding-top: 70px;
  }
  
  .page-header {
    padding: 4rem 0;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, color-mix(in srgb, var(--accent-primary) 10%, var(--bg-secondary)) 100%);
    border-bottom: 1px solid var(--border-color);
  }
  
  .page-hero {
    text-align: center;
  }
  
  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }
  
  .page-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 1rem;
  }
  
  .article-count {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--bg-card);
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    color: var(--accent-primary);
    font-weight: 500;
  }
  
  .articles-section {
    padding: 3rem 0;
  }
  
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }
  
  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
  }
  
  .back-link {
    text-align: center;
    margin-top: 3rem;
  }
  
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
    
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
