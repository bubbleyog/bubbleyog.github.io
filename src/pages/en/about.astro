---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { t } from "../../i18n";
---

<Layout title="About - Blog" description="About Blog" lang="en">
    <Header />

    <main class="about-page">
        <div class="container">
            <div class="about-content">
                <h1 class="page-title">
                    {t('en', 'about.pageTitlePrefix')} <span class="gradient-text">{t('en', 'about.pageTitle')}</span>
                </h1>

                <div class="about-section">
                    <h2>{t('en', 'about.aboutMe')}</h2>
                    <p>
                        A physics graduate student at ShanghaiTech University,
                        working on silicon-based quantum computing with a
                        dual-track focus on both theory and experiment. Other
                        interests include AI4S, computer science, and
                        philosophy (continental philosophy and traditional
                        Chinese philosophy).
                    </p>
                    <p>The content spans four main areas:</p>
                    <ul class="feature-list">
                        <li>
                            <span class="feature-icon" style="color: #f59e0b;"
                                >⚛️</span
                            >
                            <div>
                                <strong>Physics</strong> - Knowledge, news, and
                                discussion about physics.
                            </div>
                        </li>
                        <li>
                            <span class="feature-icon" style="color: #3b82f6;"
                                >💻</span
                            >
                            <div>
                                <strong>Computer</strong> - Computer usage, Linux
                                systems, and some FPGA development notes.
                            </div>
                        </li>
                        <li>
                            <span class="feature-icon" style="color: #8b5cf6;"
                                >🧠</span
                            >
                            <div>
                                <strong>Deep Learning</strong> - Principles of
                                deep learning and neural networks, plus
                                discussions of cutting-edge AI technologies.
                            </div>
                        </li>
                        <li>
                            <span class="feature-icon" style="color: #10b981;"
                                >☕</span
                            >
                            <div>
                                <strong>Misc</strong> - Learning methods, thoughts,
                                and ideas.
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="about-section">
                    <h2>{t('en', 'about.aboutMe')}</h2>
                    <p>
                        I am a lifelong learner passionate about technology. My
                        curiosity about physics helps me understand the essence
                        of the world, my love for computing lets me create tools,
                        and my interest in AI shows me the possibilities of the
                        future.
                    </p>
                    <p>
                        In my spare time, I enjoy reading, writing, and exploring
                        new technologies. I believe that interdisciplinary
                        knowledge brings a more comprehensive perspective and
                        more innovative solutions.
                    </p>
                </div>

                <div class="about-section">
                    <h2>{t('en', 'about.contact')}</h2>
                    <p>
                        {t('en', 'about.contactIntro')}
                    </p>
                    <div class="contact-links">
                        <a
                            href="mailto:bubbleyog@outlook.com"
                            class="contact-link"
                        >
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <rect x="2" y="4" width="20" height="16" rx="2"
                                ></rect>
                                <path d="M22 4l-10 8L2 4"></path>
                            </svg>
                            <span>bubbleyog@outlook.com</span>
                        </a>
                        <a
                            href="https://github.com/quallucan"
                            class="contact-link"
                        >
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                            >
                                <path
                                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                                ></path>
                            </svg>
                            <span>GitHub</span>
                        </a>
                        <a
                            href="https://x.com/quallucan"
                            class="contact-link"
                        >
                            <svg
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                            >
                                <path
                                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                ></path>
                            </svg>
                            <span>Twitter</span>
                        </a>
                    </div>
                </div>

                <div class="back-link">
                    <a href="/en" class="btn btn-secondary">
                        <svg
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path d="M19 12H5M12 19l-7-7 7-7"></path>
                        </svg>
                        <span>{t('en', 'common.backHome')}</span>
                    </a>
                </div>
            </div>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    .about-page {
        padding-top: 100px;
        padding-bottom: 4rem;
    }

    .about-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .page-title {
        font-size: 2.5rem;
        margin-bottom: 2rem;
        text-align: center;
    }

    .about-section {
        margin-bottom: 2.5rem;
    }

    .about-section h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: var(--text-primary);
    }

    .about-section p {
        color: var(--text-secondary);
        margin-bottom: 1rem;
        line-height: 1.8;
    }

    .feature-list {
        list-style: none;
        margin: 1.5rem 0;
    }

    .feature-list li {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        margin-bottom: 0.75rem;
        transition: all 0.3s ease;
    }

    .feature-list li:hover {
        border-color: var(--accent-primary);
        transform: translateX(4px);
    }

    .feature-icon {
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .contact-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1rem;
    }

    .contact-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        color: var(--text-secondary);
        transition: all 0.3s ease;
    }

    .contact-link:hover {
        border-color: var(--accent-primary);
        color: var(--text-primary);
        transform: translateY(-2px);
    }

    .back-link {
        text-align: center;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border-color);
    }

    @media (max-width: 768px) {
        .page-title {
            font-size: 2rem;
        }

        .contact-links {
            flex-direction: column;
        }

        .contact-link {
            justify-content: center;
        }
    }
</style>
