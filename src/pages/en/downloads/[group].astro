---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getAllGroups, getGroupById, getGroupName, getGroupDescription, getFilesByGroup, getArticleTitle } from '../../../data/downloads.js';
import { t } from '../../../i18n';

// 生成所有分组的静态路径
export function getStaticPaths() {
  const groups = getAllGroups();
  return groups.map((g) => ({ params: { group: g.id } }));
}

const { group } = Astro.params;
const groupInfo = getGroupById(group);

if (!groupInfo) {
  throw new Error(`Unknown download group: ${group}`);
}

const files = getFilesByGroup(group);
---

<Layout
  title={`${getGroupName(groupInfo, 'en')} - Blog`}
  description={getGroupDescription(groupInfo, 'en')}
  lang="en"
>
  <Header />

  <main class="group-page">
    <section class="page-header" style={`--group-color: ${groupInfo.color}`}>
      <div class="container">
        <div class="page-hero">
          <span class="group-icon">{groupInfo.icon}</span>
          <h1 class="page-title">{getGroupName(groupInfo, 'en')}</h1>
          <p class="page-description">{getGroupDescription(groupInfo, 'en')}</p>
        </div>
      </div>
    </section>

    <section class="files-section">
      <div class="container">
        {files.length > 0 ? (
          <div class="files-list">
            {files.map((file) => {
              const sourceTitle = getArticleTitle(file.articleId, 'en');
              return (
                <div class="file-card">
                  <div class="file-main">
                    <span class="file-name">{file.fileName}</span>
                    <div class="file-meta">
                      <span class="meta-item">{t('en', 'downloads.fileSize')}: {file.size}</span>
                      <span class="meta-item">{t('en', 'downloads.fileDate')}: {file.date}</span>
                      {sourceTitle && (
                        <span class="meta-item">
                          {t('en', 'downloads.sourceArticle')}: <a href={`/en/article/${file.articleId}`}>{sourceTitle}</a>
                        </span>
                      )}
                    </div>
                  </div>
                  <a href={file.path} class="btn btn-primary" download>
                    {t('en', 'downloads.download')}
                  </a>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-state">
            <p>{t('en', 'downloads.noFiles')}</p>
          </div>
        )}

        <div class="back-link">
          <a href="/en/downloads" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>{t('en', 'downloads.backToDownloads')}</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style define:vars={{ groupColor: groupInfo.color }}>
  .group-page {
    padding-top: 70px;
  }

  .page-header {
    padding: 4rem 0;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, color-mix(in srgb, var(--group-color) 10%, var(--bg-secondary)) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero {
    text-align: center;
  }

  .group-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    font-size: 2.5rem;
    background: color-mix(in srgb, var(--group-color) 20%, transparent);
    border-radius: var(--radius-lg);
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .page-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .files-section {
    padding: 3rem 0;
  }

  .files-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .file-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: all 0.3s ease;
  }

  .file-card:hover {
    border-color: var(--group-color);
  }

  .file-main {
    flex: 1;
    min-width: 0;
  }

  .file-name {
    display: block;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    word-break: break-all;
  }

  .file-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .meta-item {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
  }

  .back-link {
    text-align: center;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .file-card {
      flex-direction: column;
      align-items: stretch;
    }

    .file-card .btn {
      width: 100%;
    }
  }
</style>
