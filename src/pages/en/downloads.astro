---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllGroups, getGroupName, getGroupDescription } from '../../data/downloads.js';
import { t } from '../../i18n';

const groups = getAllGroups();
---

<Layout
  title="Downloads - Blog"
  description="Download physics lecture notes and related materials"
  lang="en"
>
  <Header />

  <main class="downloads-page">
    <section class="page-header">
      <div class="container">
        <div class="page-hero">
          <h1 class="page-title">{t('en', 'downloads.pageTitle')} <span class="gradient-text">{t('en', 'downloads.pageTitleKeyword')}</span></h1>
          <p class="page-description">{t('en', 'downloads.pageDescription')}</p>
        </div>
      </div>
    </section>

    <section class="groups-section">
      <div class="container">
        <div class="groups-grid">
          {groups.map((group) => (
            <a
              href={`/en/downloads/${group.id}`}
              class="group-card"
              style={`--group-color: ${group.color}`}
            >
              <div class="group-icon">{group.icon}</div>
              <div class="group-info">
                <h2 class="group-name">{getGroupName(group, 'en')}</h2>
                <p class="group-desc">{getGroupDescription(group, 'en')}</p>
                <span class="group-enter">{t('en', 'downloads.viewGroup')} →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .downloads-page {
    padding-top: 70px;
  }

  .page-header {
    padding: 4rem 0;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, color-mix(in srgb, var(--accent-primary) 10%, var(--bg-secondary)) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero {
    text-align: center;
  }

  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .page-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .groups-section {
    padding: 4rem 0;
  }

  .groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .group-card {
    display: flex;
    gap: 1rem;
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    color: inherit;
    transition: all 0.3s ease;
  }

  .group-card:hover {
    border-color: var(--group-color);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--group-color) 30%, transparent);
    color: inherit;
  }

  .group-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    background: color-mix(in srgb, var(--group-color) 15%, transparent);
    border-radius: var(--radius-md);
  }

  .group-info {
    flex: 1;
  }

  .group-name {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .group-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .group-enter {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--group-color);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .groups-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
